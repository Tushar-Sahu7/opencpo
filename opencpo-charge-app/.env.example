# OCPP Charge App — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Core API ──────────────────────────────────────────────────────────────
# URL of the OCPP Core API backend
OCPP_CORE_API=http://localhost:8000

# ── App ───────────────────────────────────────────────────────────────────
# Display title for the app (shows in browser tab and headers)
APP_TITLE=OCPP Charge

# Host and port for the charge app server
APP_HOST=0.0.0.0
APP_PORT=8003

# ── Security ──────────────────────────────────────────────────────────────
# JWT secret key — CHANGE THIS in production!
JWT_SECRET=change-me-in-production

# ── Skin ──────────────────────────────────────────────────────────────────
# Which skin to use (folder name inside skins/)
# 'default' is the generic built-in skin
# Copy and customize skins/default/ as a starting point for your own branding
SKIN=default

# ── Plugins ───────────────────────────────────────────────────────────────
# Comma-separated list of plugins to enable (from plugins/ directory)
PLUGINS=receipts,account
